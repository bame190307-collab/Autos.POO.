const autoPrincipal = {
    marca: "Toyota",
    modelo: "Corolla",
    ruedas: 4,
    arrancar() {
        console.log(this.marca + " arrancó");
    },
    frenar() {
        console.log(this.marca + " frenó");
    }
};

console.log(autoPrincipal);

autoPrincipal.marca = "Mazda";

console.log(autoPrincipal);


function Auto(marca, modelo, ruedas, year) {
    this.marca = marca;
    this.modelo = modelo;
    this.ruedas = ruedas;
    this.year = year;

    this.arrancar = function () {
        console.log(this.marca + " arrancó");
    };

    this.frenar = function () {
        console.log(this.marca + " frenó");
    };
}


// Creación de objetos con new
const auto1 = new Auto("Toyota", "Corolla", 4, 2020);
const auto2 = new Auto("Mazda", "3", 4, 2021);
const auto3 = new Auto("Honda", "Civic", 4, 2022);


// 🔹 Aquí se guardan en el arreglo llamado autos
const autos = [auto1, auto2, auto3];


let opcion;

do {
    opcion = prompt(
        "MENÚ DE AUTOS\n" +
        "1. Ver marcas de autos\n" +
        "2. Arrancar un auto\n" +
        "3. Frenar un auto\n" +
        "4. Modificar marca de un auto\n" +
        "5. Usar auto principal\n" +
        "6. Salir"
    );

    if (opcion == "1") {
        let lista = "Autos disponibles:\n";

        for (let i = 0; i < autos.length; i++) {
            lista += (i + 1) + ". " + autos[i].marca + "\n";
        }

        alert(lista);
    }

    if (opcion == "2") {
        let num = prompt("¿Qué auto quieres arrancar? (1, 2 o 3)");
        autos[num - 1].arrancar();
        alert("Revisa la consola");
    }

    if (opcion == "3") {
        let num = prompt("¿Qué auto quieres frenar? (1, 2 o 3)");
        autos[num - 1].frenar();
        alert("Revisa la consola");
    }

    if (opcion == "4") {
        let num = prompt("¿Qué auto quieres modificar? (1, 2 o 3)");
        let nuevaMarca = prompt("Nueva marca:");
        autos[num - 1].marca = nuevaMarca;
        alert("Marca actualizada");
    }

    if (opcion == "5") {
        let opcionPrincipal = prompt(
            "AUTO PRINCIPAL\n" +
            "1. Arrancar\n" +
            "2. Frenar"
        );

        if (opcionPrincipal == "1") {
            autoPrincipal.arrancar();
            alert("Revisa la consola");
        }

        if (opcionPrincipal == "2") {
            autoPrincipal.frenar();
            alert("Revisa la consola");
        }
    }

} while (opcion != "6");


// 🔹 Mostrar el arreglo completo en consola
console.log(autos);
